# --- Base de datos ---
DATABASE_URL=sqlite:///../data/stadistics4bet.db

# --- Ligas activas en este MVP (IDs canonicos de soccerdata) ---
ACTIVE_LEAGUES=ENG-Premier League,ESP-La Liga

# --- soccerdata: donde cachea sus datos descargados ---
SOCCERDATA_DIR=../data/soccerdata_cache

# --- APIs gratuitas para partidos futuros ---
# football-data.org: fixtures/resultados (tier free, ~10 req/min)
# https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_API_KEY=

# API-Football via RapidAPI: cuotas de partidos futuros (tier free, ~100 req/dia)
# https://rapidapi.com/api-sports/api/api-football
API_FOOTBALL_RAPIDAPI_KEY=

# --- Motor de probabilidades ---
# EV minimo (en fraccion, 0.05 = 5%) para marcar una recomendacion como "value"
EV_THRESHOLD=0.05

# --- App ---
LOG_LEVEL=INFO
