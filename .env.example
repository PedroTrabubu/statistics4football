# --- Base de datos ---
DATABASE_URL=sqlite:///../data/stadistics4bet.db

# --- Ligas activas en este MVP (IDs canonicos de soccerdata) ---
ACTIVE_LEAGUES=ENG-Premier League,ESP-La Liga,ESP-La Liga 2,FRA-Ligue 1
# Ligas con Picks y Recomendaciones validados (el resto solo se cargan y se muestran)
VALIDATED_LEAGUES=ENG-Premier League,ESP-La Liga,ESP-La Liga 2

# --- soccerdata: donde cachea sus datos descargados ---
SOCCERDATA_DIR=../data/soccerdata_cache

# --- APIs gratuitas para partidos futuros ---
# football-data.org: fixtures reales de proximos partidos (tier free, ~10
# req/min). Usada por scripts/ingest_fixtures.py.
# https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_API_KEY=

# No usada actualmente: el proyecto se centra en probabilidades reales
# (Dixon-Coles sobre estadisticas historicas), no en EV vs cuotas de casas de
# apuestas. Se puede dejar vacia.
API_FOOTBALL_RAPIDAPI_KEY=

# the-odds-api.com: cuotas pre-partido reales para partidos futuros (tier
# free, 500 creditos/mes = ~125 refrescos/mes para 2 ligas con h2h+totals).
# Sin esto, /recommendations para partidos futuros queda vacio (no hay con
# que comparar prob_model). Usada por scripts/refresh_odds.py.
# https://the-odds-api.com/ (registro gratis, sin tarjeta)
THE_ODDS_API_KEY=

# --- Motor de probabilidades ---
# EV minimo (en fraccion, 0.05 = 5%) para marcar una recomendacion como "value"
EV_THRESHOLD=0.05

# --- App ---
LOG_LEVEL=INFO
